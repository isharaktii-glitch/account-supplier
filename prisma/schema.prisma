datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  BUYER
  WORKER
}

enum AccountStatus {
  PENDING
  DONE
  REJECTED
}

enum PaymentStatus {
  PENDING
  BUYER_PAID
  COMPLETED
}

model User {
  id              String           @id @default(uuid())
  userCode        String           @unique
  fullName        String
  username        String           @unique // Email for Auth
  password        String
  role            Role             @default(WORKER)
  isApproved      Boolean          @default(true) // False for Buyers initially
  ratePerTask     Float            @default(1.00)
  refCommission   Float            @default(0.10)
  balance         Float            @default(0.00)
  referredById    String?
  accountsSubmitted AccountItem[]
  paymentRequests PaymentRequest[]
  createdAt       DateTime         @default(now())
}

model AccountItem {
  id           String        @id @default(uuid())
  type         String        @default("GMAIL")
  username     String
  password     String
  price        Float         @default(1.00)
  status       AccountStatus @default(PENDING)
  rejectReason String?
  workerId     String
  worker       User          @relation(fields: [workerId], references: [id])
  createdAt    DateTime      @default(now())
}

model PaymentRequest {
  id           String        @id @default(uuid())
  workerId     String
  worker       User          @relation(fields: [workerId], references: [id])
  amount       Float
  buyerSlipUrl String?
  status       PaymentStatus @default(PENDING)
  createdAt    DateTime      @default(now())
}

