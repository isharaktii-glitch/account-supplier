generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WORKER
  BUYER
}

enum AccountStatus {
  AVAILABLE
  SOLD
  REJECTED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  PAYMENT_RECEIVED
  ACCOUNT_SOLD
  ACCOUNT_REJECTED
  ANNOUNCEMENT
  PAYOUT_REQUESTED
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String
  role        Role

  workerCode  String?  @unique
  displayId   String?  @unique
  initials    String?
  balance     Float    @default(0)
  pendingBalance Float @default(0)

  referralCode String?  @unique
  referredById String?
  referredBy   User?    @relation("ReferralChain", fields: [referredById], references: [id])
  referrals    User[]   @relation("ReferralChain")

  isApproved  Boolean  @default(false)

  paymentDetails String? @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accountItems      AccountItem[]     @relation("WorkerAccounts")
  paymentRequests   PaymentRequest[]  @relation("BuyerPayments")
  notifications     Notification[]    @relation("UserNotifications")
  payoutProofs      PayoutProof[]     @relation("WorkerPayoutProofs")
  payoutRequests    PayoutRequest[]   @relation("WorkerPayoutRequests")

  @@index([role])
  @@index([referredById])
}

model AccountItem {
  id             String        @id @default(cuid())
  gmail          String
  password       String
  status         AccountStatus @default(AVAILABLE)
  rateAtEntry    Float         @default(0)
  rejectionReason String?      @db.Text

  worker      User          @relation("WorkerAccounts", fields: [workerId], references: [id])
  workerId    String

  createdAt   DateTime      @default(now())

  @@index([workerId])
  @@index([status])
}

model PaymentRequest {
  id                  String        @id @default(cuid())
  amount              Float
  proofSlipUrl        String
  buyerPaymentDetails String?       @db.Text
  status              PaymentStatus @default(PENDING)
  rejectionReason     String?       @db.Text

  buyer          User          @relation("BuyerPayments", fields: [buyerId], references: [id])
  buyerId        String

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([buyerId])
  @@index([status])
}

model PayoutProof {
  id          String   @id @default(cuid())
  amount      Float
  proofUrl    String
  note        String?  @db.Text

  worker      User     @relation("WorkerPayoutProofs", fields: [workerId], references: [id])
  workerId    String

  createdAt   DateTime @default(now())

  @@index([workerId])
}

model PayoutRequest {
  id        String               @id @default(cuid())
  amount    Float
  status    PayoutRequestStatus  @default(PENDING)

  worker    User                 @relation("WorkerPayoutRequests", fields: [workerId], references: [id])
  workerId  String

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([workerId])
  @@index([status])
}

model Notification {
  id        String            @id @default(cuid())
  type      NotificationType
  title     String
  message   String            @db.Text
  isRead    Boolean           @default(false)

  user      User              @relation("UserNotifications", fields: [userId], references: [id])
  userId    String

  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([isRead])
}

model SystemSettings {
  id                  String @id @default("global")
  taskRate            Float  @default(50)
  referralCommission  Float  @default(10)
  directJoinCounter   Int    @default(0)
  isSystemPaused      Boolean @default(false)
  updatedAt           DateTime @updatedAt
}
